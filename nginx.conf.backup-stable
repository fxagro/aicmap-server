# Nginx Configuration for mytriv.com - Static Files

server {
    listen 80;
    server_name mytriv.com www.mytriv.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name mytriv.com www.mytriv.com;

    # SSL Configuration
    ssl_certificate /etc/letsencrypt/live/mytriv.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mytriv.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/mytriv.com/chain.pem;

    # SSL Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # Root directory for static files
    root /srv/mytriv.com/mytriv-landing;
    index index.html;

    # API proxy to backend (keep the /api prefix)
    location /api/ {
        proxy_pass http://localhost:3006/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Cache static assets
    location /_next/static {
        expires 365d;
        access_log off;
    }

    location /images {
        expires 30d;
        access_log off;
    }

    location /logos {
        expires 30d;
        access_log off;
    }

    location /tech {
        expires 30d;
        access_log off;
    }

    # Special handler for translator-app OAuth callback
    location /translator-app/oauth-callback {
        try_files /translator-app/oauth-callback.html /translator-app/oauth-callback/index.html /index.html;
    }

    # Special handler for translator-app routes with .html extension
    location /translator-app {
        try_files $uri $uri.html $uri/ /index.html;
    }

    # Explicit handler for translator landing page with no-cache headers
    location /translator {
        try_files $uri $uri.html $uri/ /translator/index.html /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # Serve static files

    # SEO Hotel Pages proxy to aicmap
    location /hotel/ {
        proxy_pass http://127.0.0.1:3099;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # AI World Map API proxy
    location /maps/api/ {
        proxy_pass http://127.0.0.1:3099/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    # Error pages
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /srv/mytriv.com/mytriv-landing;
    }
}
